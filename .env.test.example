# ============================================================================
# 测试部署环境变量模板
#
#   cp .env.test.example .env      # 然后按下面注释填好每一项
#
# 注意：文件名必须是 .env（docker compose 只自动读取 .env）。
# 本文件已被 .gitignore 忽略，不会入库；但请勿把填好真实密钥的 .env 提交。
# ============================================================================

# --- 数据库密码（必填）-----------------------------------------------------
# 自定义一个强密码。首次启动后 Postgres 会用它初始化；之后改这个值会导致
# 连不上已有数据卷（数据还在，但密码不匹配）。
POSTGRES_PASSWORD=change-this-db-password

# --- JWT 签名密钥（必填，至少 32 字符）-------------------------------------
# 生成：openssl rand -hex 32
SECRET_KEY=change-this-jwt-secret-key-min-32-characters-long

# --- 平台凭据加密密钥（必填，Fernet 格式）----------------------------------
# 生成：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 或（宿主机没有 python 时）：
#   docker run --rm python:3.11-slim sh -c "pip install -q cryptography && python -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\""
#
# 本 fork 用它加密定时任务落库的账号密码与题库 token（task_store.py）。
# 生产环境缺失会拒绝启动；弄丢它则已存凭据无法解密。
CREDENTIAL_ENCRYPTION_KEY=

# --- 管理员邮箱（管理面板必需）---------------------------------------------
# 逗号分隔，不区分大小写。这里填的邮箱注册后即为管理员，才能看到
# 「管理面板」入口并访问 /api/v1/admin/*。留空 = 第一个注册的账号是管理员。
ADMIN_EMAILS=you@example.com

# --- 站点访问地址 ----------------------------------------------------------
# CORS 允许来源，必须是 JSON 数组格式（不是逗号分隔）。
#   - 用宝塔 nginx + 域名： ["https://uh.example.com"]
#   - 用 IP 直接测试：      ["http://1.2.3.4:8080"]
#   - 仅本机测试：          ["http://localhost:8080"]
# ENV=production 时不允许 "*"，且 localhost 以外的来源必须 https。
CORS_ORIGINS=["http://localhost:8080"]

# --- 额外允许的 Host（可选）------------------------------------------------
# 用户实际访问站点用的域名/IP，逗号分隔。localhost、127.0.0.1 和
# CORS_ORIGINS 里的主机始终允许；其他（局域网 IP、第二个域名）必须写在这里，
# 否则返回 400 InvalidHost。
# 例：ALLOWED_HOSTS=uh.example.com,192.168.1.10
ALLOWED_HOSTS=

# --- 端口 ------------------------------------------------------------------
# app 在宿主机回环上的端口（调试用，外部访问走 web 容器）。
APP_PORT=8000
# web 容器对外端口（宝塔 nginx 反代目标，或直接访问的端口）。
HTTP_PORT=8080
# web 容器绑定地址：
#   127.0.0.1 = 只允许本机/宝塔 nginx 反代访问（推荐，配合域名+HTTPS）
#   0.0.0.0   = 允许用 http://服务器IP:8080 直接访问（仅测试期，注意明文传输）
HTTP_BIND_HOST=127.0.0.1

# --- 运行环境 --------------------------------------------------------------
# dev       = 放宽校验，适合 IP 直连测试
# production= 严格校验（CORS 必须 https、ALLOWED_HOSTS 不能为 *）
ENV=dev

# --- 前端构建镜像源（可选）-------------------------------------------------
# 国内服务器加速用；海外或走代理可删掉这一行。
NPM_REGISTRY=https://registry.npmmirror.com

# --- 其他可选 --------------------------------------------------------------
# 本 fork 不要跟随上游版本提醒，测试期保持关闭。
UPDATE_CHECK_ENABLED=false
# 需要暴露 /docs 和 /openapi.json 时设为 true（便于核对新接口）。
# DOCS_ENABLED=true
# 排查问题时用：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
